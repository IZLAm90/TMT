<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="350dp"
    android:layout_height="180dp"
    android:layout_margin="5dp"
    android:background="@drawable/shape_round_out_line"
    android:padding="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/userImg"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/get_family_doc"
        android:theme="@style/roundedImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/userName"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:gravity="center"
        android:fontFamily="@font/tajwal"
        android:text="@string/me"
        android:textColor="@color/textColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userImg" />

    <ImageView
        android:id="@+id/quta"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/quta"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/userImg"
        />

    <TextView
        android:id="@+id/userFeedBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="2"
        android:gravity="center"
        android:fontFamily="@font/tajwal"
        android:text="الدكتور الله يجزيه خير متعاون و بشوش الله ينفع بيه "
        android:textColor="@color/textColor"
        app:layout_constraintEnd_toStartOf="@id/userImg"
        app:layout_constraintTop_toBottomOf="@+id/quta" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="270dp"
            android:layout_height="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/userFeedBack"
            android:background="@drawable/shape_round_out_line"

            >
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/docImg"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/speciality_icon"
                android:theme="@style/RoundedImageRight"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/docName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:fontFamily="@font/tajwal"
                android:text="د. ايمن علي محمود"
                android:textColor="@color/textColor"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/docImg"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/docSpeciality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="طب عام"
                android:textColor="@color/textColor"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/tajwal"
                app:layout_constraintEnd_toStartOf="@+id/docImg"
                app:layout_constraintTop_toBottomOf="@id/docName" />

            <TextView
                android:id="@+id/docSpecialityin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/tajwal"
                android:background="@drawable/rounded_background_gray"
                android:paddingHorizontal="5dp"
                android:text="طبيب عام"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:visibility="gone"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/docImg"
                app:layout_constraintTop_toBottomOf="@id/docSpeciality" />

            <ImageView
                android:id="@+id/star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="5dp"
                android:src="@drawable/icon_star"
                app:layout_constraintEnd_toStartOf="@+id/docImg"
                app:layout_constraintTop_toBottomOf="@id/docSpecialityin" />

            <TextView
                android:id="@+id/rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/tajwal"
                android:paddingHorizontal="5dp"
                android:hint="(48 مراجعات )4.7"
                android:textColor="@color/gray"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/star"
                app:layout_constraintTop_toBottomOf="@id/docSpecialityin" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_like_un"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="12dp"
                android:visibility="gone"
                />
            <ImageView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/icon_back_status_doc"
                android:src="@drawable/icon_red"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>