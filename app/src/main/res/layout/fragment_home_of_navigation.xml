<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".presentation.fragment.homenavigation.HomeOfNavigationFragment">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/back"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:text="@string/weCanHelp"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:fontFamily="@font/tajwal"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_margin="5dp"
            android:background="@drawable/shape_round_out_line"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:scaleType="fitCenter"
                android:src="@drawable/medicalcare"
                app:shapeAppearance="@style/RoundedImageRight" />

            <TextView
                android:id="@+id/oneTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/inf"
                android:gravity="center"
                android:fontFamily="@font/tajwal"
                android:text="@string/speedCare"
                android:textColor="@color/textColor"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/cont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle"
                android:layout_toStartOf="@id/inf"
                android:gravity="center"
                android:padding="5dp"
                android:fontFamily="@font/tajwal"
                android:paddingVertical="2dp"
                android:text="@string/askForSpeciality"
                android:textColor="@color/gray"
                android:textSize="11sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/SpecialToke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cont"
                android:layout_alignParentStart="true"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/shape_round_orang"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:text="@string/getHelp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:drawablePadding="5dp"
                app:drawableStartCompat="@drawable/ic_irrow_back" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_margin="5dp"
            android:background="@drawable/shape_round_out_line"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf2"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:scaleType="fitCenter"
                android:src="@drawable/medicalcare"
                app:shapeAppearance="@style/RoundedImageRight" />

            <TextView
                android:id="@+id/oneTitle2"
                android:fontFamily="@font/tajwal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/inf2"
                android:gravity="center"
                android:text="@string/speciality"
                android:textColor="@color/textColor"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/cont2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle2"
                android:layout_toStartOf="@id/inf2"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:padding="5dp"
                android:fontFamily="@font/tajwal"
                android:text="@string/askForSpeciality"
                android:textColor="@color/gray"
                android:textFontWeight="500"
                android:textSize="11sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/consaltant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cont2"
                android:layout_alignParentStart="true"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_round_orang"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:text="@string/getHelp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="normal"
                android:drawablePadding="5dp"
                app:drawableStartCompat="@drawable/ic_irrow_back" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_margin="5dp"
            android:background="@drawable/shape_round_out_line"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf3"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:scaleType="fitCenter"
                android:src="@drawable/mentalitycare"
                app:shapeAppearance="@style/RoundedImageRight" />

            <TextView
                android:id="@+id/oneTitle3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/tajwal"

                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/inf3"
                android:gravity="center"
                android:text="@string/speciality"
                android:textColor="@color/textColor"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/cont3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle3"
                android:layout_toStartOf="@id/inf3"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:text="@string/mentality"
                android:textColor="@color/gray"
                android:textSize="11sp"
                android:padding="5dp"
                android:fontFamily="@font/tajwal"
                android:textStyle="normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cont3"
                android:layout_alignParentStart="true"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_round_orang"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:text="@string/getHelp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:drawablePadding="5dp"
                app:drawableStartCompat="@drawable/ic_irrow_back" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_margin="5dp"
            android:background="@drawable/shape_round_out_line"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf4"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:scaleType="fitCenter"
                android:src="@drawable/healthecare"
                app:shapeAppearance="@style/RoundedImageRight" />

            <TextView
                android:id="@+id/oneTitle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/inf4"
                android:gravity="center"
                android:fontFamily="@font/tajwal"
                android:text="@string/HealthCare"
                android:textColor="@color/textColor"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/cont4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle4"
                android:layout_toStartOf="@id/inf4"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:text="@string/healthyDetails"
                android:textColor="@color/gray"
                android:textSize="11sp"
                android:padding="5dp"
                android:fontFamily="@font/tajwal"
                android:textStyle="normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cont4"
                android:layout_alignParentStart="true"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_round_orang"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:text="@string/getHelp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:drawablePadding="5dp"
                app:drawableStartCompat="@drawable/ic_irrow_back" />

        </RelativeLayout>


    </LinearLayout>
    <!--    <com.google.android.material.bottomnavigation.BottomNavigationView-->
    <!--        android:id="@+id/bottomNavigationView"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:elevation="1000dp"-->
    <!--        app:layout_constraintStart_toStartOf="parent"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
    <!--        app:menu="@menu/bottom_navigation_menu"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent" />-->

</androidx.constraintlayout.widget.ConstraintLayout>