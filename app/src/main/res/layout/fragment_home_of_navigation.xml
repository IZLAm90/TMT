<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".presentation.fragment.homenavigation.HomeOfNavigationFragment">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        android:background="@color/roundedTVColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:src="@drawable/back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:text="@string/weCanHelp"
            android:textColor="@color/textColor"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/shape_round_out_line"
            android:layout_margin="5dp"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:shapeAppearance="@style/RoundedImageRight"
                android:src="@drawable/testimg" />
            <TextView
                android:id="@+id/oneTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/inf"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:text="@string/speciality" />



            <TextView
                android:id="@+id/cont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle"
                android:layout_toStartOf="@id/inf"
                android:layout_marginTop="4dp"
                android:paddingVertical="2dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="@string/askForSpeciality"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/SpecialToke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_below="@id/cont"
                android:layout_gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_round_orang"
                android:textColor="@color/white"
                android:text="@string/getHelp"
                android:layout_marginEnd="10dp"
                app:drawableStartCompat="@drawable/ic_irrow"
                android:textSize="13sp"
                />

        </RelativeLayout>
        <RelativeLayout
            android:background="@drawable/shape_round_out_line"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf2"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:shapeAppearance="@style/RoundedImageRight"
                android:src="@drawable/testimg" />
            <TextView
                android:id="@+id/oneTitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/inf2"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:text="@string/speciality" />



            <TextView
                android:id="@+id/cont2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle2"
                android:layout_toStartOf="@id/inf2"
                android:layout_marginTop="4dp"
                android:paddingVertical="2dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="@string/askForSpeciality"
                android:textSize="14sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_below="@id/cont2"
                android:layout_gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_round_orang"
                android:textColor="@color/white"
                android:text="@string/getHelp"
                android:layout_marginEnd="10dp"
                app:drawableStartCompat="@drawable/ic_irrow"
                android:textSize="13sp"
                />

        </RelativeLayout>
        <RelativeLayout
            android:background="@drawable/shape_round_out_line"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf3"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:shapeAppearance="@style/RoundedImageRight"
                android:src="@drawable/testimg" />
            <TextView
                android:id="@+id/oneTitle3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/inf3"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:text="@string/speciality" />

            <TextView
                android:id="@+id/cont3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle3"
                android:layout_toStartOf="@id/inf3"
                android:layout_marginTop="4dp"
                android:paddingVertical="2dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="@string/askForSpeciality"
                android:textSize="14sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_below="@id/cont3"
                android:layout_gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_round_orang"
                android:textColor="@color/white"
                android:text="@string/getHelp"
                android:layout_marginEnd="10dp"
                app:drawableStartCompat="@drawable/ic_irrow"
                android:textSize="13sp"
                />

        </RelativeLayout>
        <RelativeLayout
            android:background="@drawable/shape_round_out_line"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/inf4"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:shapeAppearance="@style/RoundedImageRight"
                android:src="@drawable/testimg" />
            <TextView
                android:id="@+id/oneTitle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/inf4"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:text="@string/speciality" />



            <TextView
                android:id="@+id/cont4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/oneTitle4"
                android:layout_toStartOf="@id/inf4"
                android:layout_marginTop="4dp"
                android:paddingVertical="2dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="@string/askForSpeciality"
                android:textSize="14sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_below="@id/cont4"
                android:layout_gravity="center"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_round_orang"
                android:textColor="@color/white"
                android:text="@string/getHelp"
                android:layout_marginEnd="10dp"
                app:drawableStartCompat="@drawable/ic_irrow"
                android:textSize="13sp"
                />

        </RelativeLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>