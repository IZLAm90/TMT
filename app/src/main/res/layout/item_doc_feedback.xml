<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/shape_round_out_line"
    android:padding="5dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/userImg"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/get_family_doc"
        android:theme="@style/circleImage"
        android:layout_margin="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/userName"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:gravity="center"
        android:fontFamily="@font/tajwal"
        android:text="@string/me"
        android:textColor="@color/textColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userImg" />

    <ImageView
        android:id="@+id/quta"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/quta"
        android:layout_margin="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/userImg"
        />

    <TextView
        android:id="@+id/userFeedBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/tajwal"
        android:text="الدكتور الله يجزيه خير متعاون و بشوش الله ينفع بيه "
        android:textColor="@color/textColor"
        app:layout_constraintEnd_toStartOf="@id/userImg"
        app:layout_constraintTop_toBottomOf="@+id/quta" />


</androidx.constraintlayout.widget.ConstraintLayout>