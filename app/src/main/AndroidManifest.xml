<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <application
        android:name=".presentation.ApplicaTion"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TMT"
        tools:targetApi="31">
        <activity
            android:name=".presentation.activity.login.LoginActivity"
            android:exported="true"
            android:theme="@style/AppTheme.TransparentStatusBarLogin"
            android:screenOrientation="portrait"
            />
        <activity android:name=".presentation.activity.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/AppTheme.TransparentStatusBar"
            android:screenOrientation="portrait"
            >
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TMT"
            android:screenOrientation="portrait"
            >
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>
    </application>

</manifest>